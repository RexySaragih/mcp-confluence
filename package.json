{
  "name": "@rexymayderio/jira-confluence-mcp",
  "version": "1.1.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jira-confluence-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/**/*.test.js",
    "test:watch": "tsc -p tsconfig.test.json --watch"
  },
  "keywords": [
    "mcp",
    "jira",
    "confluence",
    "atlassian"
  ],
  "author": "rexymayderio",
  "license": "ISC",
  "description": "MCP server for Jira and Confluence integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexySaragih/mcp-confluence.git"
  },
  "homepage": "https://github.com/RexySaragih/mcp-confluence#readme",
  "bugs": {
    "url": "https://github.com/RexySaragih/mcp-confluence/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4",
    "marked": "^15.0.6",
    "turndown": "^7.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/turndown": "^5.0.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
